<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security config: system CAs, HTTPS only. The hardened default, and
  what an unmodified generated app points at.

  There are six of these files, one per combination of {system, user+system,
  user} trust anchors and {HTTPS only, plaintext allowed}. The generator does
  not build one: it rewrites android:networkSecurityConfig on <application> to
  reference whichever of these six the user's settings select.

  That is deliberate. Every network policy a generated app can possibly hold is
  checked into this directory and readable here, rather than assembled at
  generation time out of the config JSON. `aapt2 dump xmltree` on any generated
  APK shows one of these six, unchanged.

  WebView honours cleartext permission and custom trust anchors from this file.
  It ignores <debug-overrides> and per-domain certificate pinning, so neither
  appears here — a directive that does nothing is worse than no directive.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
